# Frontend → API (empty = use Vite proxy /api → localhost:3001)
# VITE_API_BASE_URL=http://localhost:3001

# Optional S3-compatible direct upload (MinIO / AWS S3).
# All five values must be present to enable browser-direct multipart upload.
# OBJECT_STORAGE_ENDPOINT=http://localhost:9000
# OBJECT_STORAGE_PUBLIC_ENDPOINT=http://localhost:9000
# OBJECT_STORAGE_BUCKET=artifacts
# OBJECT_STORAGE_ACCESS_KEY=artifact-minio
# OBJECT_STORAGE_SECRET_KEY=change-this-minio-secret
# OBJECT_STORAGE_REGION=us-east-1
