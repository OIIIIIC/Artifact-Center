# Copy to apps/api/.env
PORT=3001
DATABASE_URL=postgres://artifact:artifact@localhost:5432/artifact_center
JWT_SECRET=dev-change-me-artifact-center-jwt-secret
# 分享链接 HMAC pepper（生产必填 ≥32 字符；开发可省略并回落 JWT_SECRET）
# SHARE_TOKEN_PEPPER=replace-with-a-long-random-share-pepper

# 可选：覆盖仅用于本地开发的 seed 管理员
# SEED_USERNAME=artifact-demo
# SEED_EMAIL=artifact-demo@enterprise.local
# SEED_PASSWORD=ArtifactCenter-Demo-Only-2026!
# SEED_NAME=Artifact Demo
# Absolute or relative to process cwd (run from apps/api)
STORAGE_PATH=../../data/files
CORS_ORIGIN=http://localhost:5173
